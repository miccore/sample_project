<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Miccore.Net.CleanArchitectureTemplate</id>
    <version>1.0.0</version>
    <description>
      A production-ready Clean Architecture template for .NET microservices implementing CQRS, MediatR, FastEndpoints, and Entity Framework Core.
      Includes complete project structure with API, Application, Core, and Infrastructure layers, plus comprehensive test coverage.
    </description>
    <authors>Miccore</authors>
    <owners>Miccore</owners>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/miccore/sample_project</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <releaseNotes>Initial release of Miccore Clean Architecture Template</releaseNotes>
    <copyright>Copyright 2026 Miccore</copyright>
    <tags>dotnet-new templates clean-architecture cqrs microservice fastendpoints mediatr entityframework aspnetcore vertical-slice hexagonal onion</tags>
    <packageTypes>
      <packageType name="Template" />
    </packageTypes>
  </metadata>
  <files>
    <file src="**\*" target="content" exclude="**\bin\**;**\obj\**;**\.vs\**;**\.vscode\**;**\logs\**;**\.git\**;**\*.user;**\.github\**;.template.config\**\*" />
    <file src=".template.config\**\*" target="content\.template.config" />
  </files>
</package>
